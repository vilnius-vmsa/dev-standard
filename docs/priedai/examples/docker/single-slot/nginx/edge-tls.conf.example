# Inactive example. Copy to docker/nginx/conf.d/edge-tls.conf. It is NOT baked
# into the image: single-slot Compose mounts it into the `nginx` service, the
# only place where that topology terminates TLS. Blue-green slots do not mount
# it (they have no TLS secrets); there the balancer terminates TLS.
#
# The TLS listener only terminates TLS and hands the request to the local
# application listener, so the application configuration exists once.

server {
    listen 8443 ssl;
    server_name _;

    ssl_certificate /run/secrets/tls_certificate;
    ssl_certificate_key /run/secrets/tls_private_key;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 16M;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # Not shorter than fastcgi_read_timeout of the application listener.
        proxy_read_timeout 130s;
        proxy_send_timeout 130s;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
    }
}
