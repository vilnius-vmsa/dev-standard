# syntax=docker/dockerfile:1.7
#
# Reference multi-stage Nginx image for an application that compiles frontend
# assets before serving the public directory. Replace both build arguments with
# reviewed immutable manifests before building.

ARG NODE_ASSET_IMAGE
FROM ${NODE_ASSET_IMAGE} AS assets

WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Copy only the frontend inputs needed by the asset build. Adapt these paths
# for the consuming application; do not copy .env, credentials or .git.
COPY resources resources
COPY vite.config.* webpack.mix.js  ./
RUN npm run build

ARG NGINX_RUNTIME_IMAGE
FROM ${NGINX_RUNTIME_IMAGE} AS runtime

WORKDIR /var/www

# The PHP image owns the application source; this image contains only the
# public web root and compiled assets required by Nginx.
COPY public public
COPY --from=assets /src/public/build public/build
COPY docker/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf

RUN mkdir -p /var/cache/nginx /var/run \
    && chown -R nginx:nginx /var/cache/nginx /var/run /var/www /etc/nginx

USER nginx
EXPOSE 8080
STOPSIGNAL SIGQUIT
CMD ["nginx", "-g", "daemon off;"]
