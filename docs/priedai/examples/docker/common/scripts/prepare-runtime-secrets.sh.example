#!/usr/bin/env bash
# Inactive example. Copy to docker/scripts/prepare-runtime-secrets.sh.

set -euo pipefail

: "${RUNTIME_ENV:?RUNTIME_ENV must contain the complete application environment}"
: "${DEPLOY_ENVIRONMENT:?DEPLOY_ENVIRONMENT must be staging or production}"
: "${SECRETS_DIR:?SECRETS_DIR must identify the host-only runtime directory}"
: "${TLS_CERTIFICATE_B64:?TLS_CERTIFICATE_B64 must contain the Base64 certificate}"
: "${TLS_PRIVATE_KEY_B64:?TLS_PRIVATE_KEY_B64 must contain the Base64 private key}"

umask 077

case "$DEPLOY_ENVIRONMENT" in
  staging|production) ;;
  *) echo "Unsupported DEPLOY_ENVIRONMENT: $DEPLOY_ENVIRONMENT" >&2; exit 1 ;;
esac

validate_digest() {
  local name="$1" value="${!1:-}"
  [[ "$value" =~ ^[^@[:space:]]+@sha256:[0-9a-f]{64}$ ]] || {
    printf '%s must be an immutable repository@sha256:digest reference.\n' "$name" >&2
    exit 1
  }
}

unquote() {
  local value="$1" quote rest
  quote="${value:0:1}"
  if [[ "$quote" == '"' || "$quote" == "'" ]]; then
    rest="${value:1}"
    if [[ "$rest" == *"$quote"* ]]; then
      value="${rest%%"$quote"*}"
      rest="${rest#*"$quote"}"
      if [[ ! "$rest" =~ ^[[:space:]]*(#.*)?$ ]]; then
        echo 'RUNTIME_ENV has text after the closing quote of a value.' >&2
        exit 1
      fi
    fi
  else
    value="${value%%[[:space:]]#*}"
    value="${value%"${value##*[![:space:]]}"}"
  fi
  printf '%s' "$value"
}

env_value() {
  unquote "$(awk -v key="$1" 'index($0, key "=") == 1 { value = substr($0, length(key) + 2) } END { print value }' "$source_env")"
}

env_values() {
  local value
  while IFS= read -r value; do
    unquote "$value"
    printf '\n'
  done < <(awk -v key="$1" 'index($0, key "=") == 1 { print substr($0, length(key) + 2) }' "$source_env")
}

source_dir="$(mktemp -d)"
source_env="$source_dir/source.env"
printf '%s\n' "$RUNTIME_ENV" > "$source_env"

cleanup() {
  if [[ -n "${staged_dir:-}" && -d "$staged_dir" ]]; then
    rm -rf "$staged_dir"
  fi
  rm -rf "$source_dir"
}
restore_previous() {
  if [[ -n "${backup_dir:-}" && ! -e "$SECRETS_DIR" && -e "$backup_dir" ]]; then
    mv "$backup_dir" "$SECRETS_DIR"
  fi
  cleanup
}
trap restore_previous EXIT

if grep -nEv '^([A-Z_][A-Z0-9_]*=.*|[[:space:]]*(#.*)?)$' "$source_env" | cut -d: -f1 | grep -q .; then
  printf 'RUNTIME_ENV line(s) %s are not plain upper-case KEY=value assignments or comments.\n' \
    "$(grep -nEv '^([A-Z_][A-Z0-9_]*=.*|[[:space:]]*(#.*)?)$' "$source_env" | cut -d: -f1 | tr '\n' ' ')" >&2
  exit 1
fi

app_env="$(env_value APP_ENV)"
db_database="$(env_value DB_DATABASE)"
db_username="$(env_value DB_USERNAME)"
db_password="$(env_value DB_PASSWORD)"
db_root_password="$(env_value DB_ROOT_PASSWORD)"
redis_password="$(env_value REDIS_PASSWORD)"

[[ -n "$app_env" && -n "$db_database" && -n "$db_username" ]] || {
  echo 'RUNTIME_ENV must define APP_ENV, DB_DATABASE and DB_USERNAME.' >&2
  exit 1
}
[[ -n "$db_password" && -n "$db_root_password" && -n "$redis_password" ]] || {
  echo 'RUNTIME_ENV must define DB_PASSWORD, DB_ROOT_PASSWORD and REDIS_PASSWORD.' >&2
  exit 1
}
for password_name in DB_PASSWORD DB_ROOT_PASSWORD REDIS_PASSWORD; do
  password_value="$(env_value "$password_name")"
  if [[ "$password_value" == *"'"* || "$password_value" == *'"'* || "$password_value" == *'\'* ]]; then
    echo "$password_name must not contain a quote or a backslash." >&2
    exit 1
  fi
done
unset password_value

case "$DEPLOY_ENVIRONMENT:$app_env" in
  production:production|staging:staging|staging:production) ;;
  *) echo "APP_ENV=$app_env is not valid for $DEPLOY_ENVIRONMENT." >&2; exit 1 ;;
esac
while IFS= read -r app_debug; do
  case "$(printf '%s' "$app_debug" | tr '[:upper:]' '[:lower:]')" in
    ''|false|'(false)'|0) ;;
    *) echo 'APP_DEBUG must be disabled for a deployed environment.' >&2; exit 1 ;;
  esac
done < <(env_values APP_DEBUG)

SECRET_KEYS="APP_KEY DB_PASSWORD DB_ROOT_PASSWORD REDIS_PASSWORD"

NON_SECRET_KEYS=""

listed_in() {
  case " $2 " in
    *" $1 "*) return 0 ;;
  esac
  return 1
}

looks_secret() {
  local part
  for part in ${1//_/ }; do
    case "$part" in
      PASSWORD|PASSWD|PWD|SECRET|SECRETS|TOKEN|TOKENS|KEY|KEYS|SALT|DSN|PRIVATE|CREDENTIAL|CREDENTIALS)
        return 0
        ;;
    esac
  done
  return 1
}

unknown_secrets=""
while IFS= read -r env_key; do
  listed_in "$env_key" "$SECRET_KEYS" && continue
  listed_in "$env_key" "$NON_SECRET_KEYS" && continue
  if looks_secret "$env_key"; then
    unknown_secrets="$unknown_secrets $env_key"
  fi
done < <(sed -nE 's/^([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$source_env" | sort -u)
while IFS= read -r env_key; do
  listed_in "$env_key" "$SECRET_KEYS" && continue
  if [[ "$(env_value "$env_key")" =~ ://[^/@[:space:]]+:[^/@[:space:]]+@ ]]; then
    unknown_secrets="$unknown_secrets $env_key"
  fi
done < <(sed -nE 's/^([A-Z_][A-Z0-9_]*)=.*/\1/p' "$source_env" | sort -u)

if [[ -n "$unknown_secrets" ]]; then
  printf 'RUNTIME_ENV contains keys that look like secrets but are not allowlisted:%s.\n' "$unknown_secrets" >&2
  printf 'Add each to SECRET_KEYS (with a secret file, an entrypoint line and a Compose secret) or to NON_SECRET_KEYS.\n' >&2
  exit 1
fi

app_key="$(env_value APP_KEY)"
[[ -n "$app_key" ]] || {
  echo 'RUNTIME_ENV must define APP_KEY.' >&2
  exit 1
}

if [[ -n "${PHP_IMAGE_REF:-}" || -n "${NGINX_IMAGE_REF:-}" ]]; then
  : "${PHP_IMAGE_REF:?PHP_IMAGE_REF is required for single-slot}"
  : "${NGINX_IMAGE_REF:?NGINX_IMAGE_REF is required for single-slot}"
  validate_digest PHP_IMAGE_REF
  validate_digest NGINX_IMAGE_REF
else
  for image_name in PHP_IMAGE_BLUE PHP_IMAGE_GREEN NGINX_IMAGE_BLUE NGINX_IMAGE_GREEN BALANCER_IMAGE_REF; do
    validate_digest "$image_name"
  done
  : "${BALANCER_CONFIG_DIR:?BALANCER_CONFIG_DIR is required for blue-green}"
fi

write_file() {
  local name="$1" mode="$2" value="$3"
  printf '%s\n' "$value" > "$staged_dir/$name"
  chmod "$mode" "$staged_dir/$name"
}

write_secret() {
  local name="$1" value="$2"
  printf '%s' "$value" > "$staged_dir/$name"
  chmod 0444 "$staged_dir/$name"
}

write_application_env() {
  local line key value check_value
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)= ]] && listed_in "${BASH_REMATCH[1]}" "$SECRET_KEYS"; then
      continue
    fi
    if [[ "$line" =~ ^([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
      key="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      if [[ "${value:0:1}" != "'" ]]; then
        check_value="${value//\$\$/}"
        if [[ "$check_value" =~ \$[A-Za-z_{] ]]; then
          printf '%s contains a `$` that Compose would interpolate. Write it as `$$` or put the value in single quotes.\n' "$key" >&2
          exit 1
        fi
      fi
    fi
    printf '%s\n' "$line"
  done < "$source_env" > "$staged_dir/application.env"
  chmod 0600 "$staged_dir/application.env"
}

write_base64_file() {
  local name="$1" value="$2"
  if ! printf '%s' "$value" | base64 --decode > "$staged_dir/$name"; then
    printf '%s must contain valid Base64 data.\n' "$name" >&2
    exit 1
  fi
  chmod 0444 "$staged_dir/$name"
}

target_parent="$(dirname "$SECRETS_DIR")"
mkdir -p "$target_parent"
chmod 0700 "$target_parent"
staged_dir="$(mktemp -d "$target_parent/.runtime-secrets.XXXXXX")"
write_application_env
write_secret app_key "$app_key"
write_secret mysql_password "$db_password"
write_secret mysql_root_password "$db_root_password"
write_secret redis_password "$redis_password"
write_base64_file tls_certificate "$TLS_CERTIFICATE_B64"
write_base64_file tls_private_key "$TLS_PRIVATE_KEY_B64"

if [[ -n "${ALLOY_ENV:-}" && -n "${LOKI_PASSWORD:-}" ]]; then
  write_file alloy.env 0600 "$ALLOY_ENV"
  write_secret loki_password "$LOKI_PASSWORD"
fi

openssl x509 -in "$staged_dir/tls_certificate" -noout >/dev/null 2>&1 || {
  echo 'TLS_CERTIFICATE_B64 does not decode to a valid PEM certificate.' >&2
  exit 1
}
openssl pkey -in "$staged_dir/tls_private_key" -noout >/dev/null 2>&1 || {
  echo 'TLS_PRIVATE_KEY_B64 does not decode to a valid unencrypted private key.' >&2
  exit 1
}
cmp -s \
  <(openssl pkey -in "$staged_dir/tls_private_key" -pubout -outform DER) \
  <(openssl x509 -in "$staged_dir/tls_certificate" -pubkey -noout | openssl pkey -pubin -pubout -outform DER) || {
  echo 'TLS certificate and private key do not form a pair.' >&2
  exit 1
}
openssl x509 -in "$staged_dir/tls_certificate" -noout -checkend 0 >/dev/null || {
  echo 'TLS certificate is expired.' >&2
  exit 1
}

compose_env="$staged_dir/compose.env"
{
  printf 'SECRETS_DIR=%s\n' "$SECRETS_DIR"
  printf 'DB_DATABASE=%s\n' "$db_database"
  printf 'DB_USERNAME=%s\n' "$db_username"
  for variable in \
    PHP_IMAGE_REF NGINX_IMAGE_REF \
    PHP_IMAGE_BLUE PHP_IMAGE_GREEN NGINX_IMAGE_BLUE NGINX_IMAGE_GREEN \
    BALANCER_IMAGE_REF BALANCER_CONFIG_DIR; do
    if [[ -n "${!variable:-}" ]]; then
      printf '%s=%s\n' "$variable" "${!variable}"
    fi
  done
} > "$compose_env"
chmod 0600 "$compose_env"

chmod 0700 "$staged_dir"

backup_dir=""
if [[ -e "$SECRETS_DIR" ]]; then
  backup_dir="$(mktemp -d "$target_parent/.runtime-secrets-old.XXXXXX")"
  rmdir "$backup_dir"
  mv "$SECRETS_DIR" "$backup_dir"
fi
mv "$staged_dir" "$SECRETS_DIR" || exit 1
staged_dir=""
if [[ -n "$backup_dir" ]]; then
  rm -rf "$backup_dir"
  backup_dir=""
fi

printf 'Prepared runtime secrets and compose.env in %s.\n' "$SECRETS_DIR"
