#!/bin/sh

# Inactive example. Copy to docker/php-fpm/entrypoint.sh; the production
# Dockerfile installs it as the image ENTRYPOINT.
#
# Secrets never travel in the application environment file. Compose mounts
# each one as a file under /run/secrets and this entrypoint exports it for the
# PHP process only, so the values do not appear in `docker inspect`, in the
# Compose configuration or in the image. The container receives only the
# secrets listed here; in particular the database root password is mounted
# into the database service alone and is never available to the application.

set -eu

load_secret() {
    variable_name="$1"
    secret_file="/run/secrets/$2"

    # A missing file is allowed so the image also runs outside Compose.
    [ -r "$secret_file" ] || return 0
    export "${variable_name}=$(cat "$secret_file")"
}

# Keep this list aligned with SECRET_KEYS in docker/scripts/prepare-runtime-secrets.sh
# and with the `secrets:` of the PHP services in the production Compose file.
load_secret APP_KEY app_key
load_secret DB_PASSWORD mysql_password
load_secret REDIS_PASSWORD redis_password

exec docker-php-entrypoint "$@"
