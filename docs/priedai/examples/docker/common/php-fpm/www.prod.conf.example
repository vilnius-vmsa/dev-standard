; Inactive example. Copy to docker/php-fpm/pool.d/www.prod.conf.

[global]
process_control_timeout = 120s

[www]
user = app
group = app
listen = 9000
pm = dynamic
pm.max_children = 8
pm.start_servers = 2
pm.min_spare_servers = 1
pm.max_spare_servers = 4
pm.max_requests = 500
ping.path = /fpm-ping
ping.response = pong
pm.status_path = /fpm-status
clear_env = no
catch_workers_output = yes
php_admin_flag[log_errors] = on
php_admin_value[error_log] = /dev/stderr
access.log = /dev/null
