# syntax=docker/dockerfile:1.7
# Inactive example. Copy to docker/nginx/Dockerfile.prod and replace all
# placeholders. Build from the exact PHP image digest used by the release.

ARG PHP_IMAGE_REF
FROM ${PHP_IMAGE_REF} AS application

FROM nginx:1.27-alpine@sha256:REPLACE_WITH_NGINX_DIGEST AS runtime

# The PHP image owns the application build and public assets. The Nginx image
# contains only the public web root and server configuration.
COPY --from=application /var/www/public /usr/share/nginx/html
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
# Role-neutral configuration, identical for single-slot and both blue-green
# slots (examples: nginx/site.conf.example, nginx/upstream.conf.example):
# - default.conf   application listener 8080 and private monitoring 18080;
# - upstream.conf  the default PHP-FPM upstream (`php`, single-slot).
COPY docker/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx/conf.d/upstream.conf /etc/nginx/conf.d/upstream.conf

# Role-specific configuration is not baked in; Compose mounts it:
# - blue-green slots mount upstream.blue.conf / upstream.green.conf over
#   upstream.conf, so one image digest serves both slots and each slot talks
#   to its own PHP-FPM service;
# - single-slot mounts edge-tls.conf, the 8443 TLS listener that references
#   /run/secrets/tls_certificate and /run/secrets/tls_private_key. Slots have
#   no TLS secrets and do not mount it; the balancer terminates TLS there.
#
# Health contract:
# - /health on the application listener: liveness, answered by Nginx itself;
# - /health/ready on the private 18080 listener only: readiness, passed to
#   PHP-FPM; the application checks its critical dependencies and returns
#   {"status":"ok","checks":{...},"release":"<source SHA>"}. The application
#   listener returns 404 for /health/ready.
# Deployment and slot-switch gates use /health/ready, never /health.

# The PHP image links public/storage to storage/app/public. That target does
# not exist here, so replace the dangling link with a directory: Compose
# mounts the uploads volume on it read-only.
RUN rm -f /usr/share/nginx/html/storage \
    && install -d -m 0755 /usr/share/nginx/html/storage \
    && mkdir -p /var/cache/nginx /var/run \
    && chown -R nginx:nginx /var/cache/nginx /var/run /usr/share/nginx/html

USER nginx
# Production Compose maps host port 443 to the TLS listener on container 8443;
# blue-green Compose exposes only the internal 8080 and 18080 listeners to its
# balancer. The development image/Compose remains HTTP on 8080.
EXPOSE 8080 8443 18080
CMD ["nginx", "-g", "daemon off;"]
