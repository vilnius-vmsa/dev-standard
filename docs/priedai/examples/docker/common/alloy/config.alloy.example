// Inactive example. Copy to docker/alloy/config.alloy.

logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "containers" {
  host = "http://docker-socket-proxy:2375"

  filter {
    name   = "label"
    values = ["app.logging.enabled=true"]
  }
}

discovery.relabel "container_logs" {
  targets = discovery.docker.containers.targets

  rule {
    target_label = "app"
    replacement  = "<application>"
  }

  rule {
    target_label = "environment"
    replacement  = sys.env("DEPLOY_ENV")
  }

  rule {
    target_label = "node"
    replacement  = sys.env("NODE_NAME")
  }

  rule {
    source_labels = ["__meta_docker_container_label_app_logging_type"]
    target_label  = "type"
  }

  rule {
    source_labels = ["__meta_docker_container_label_app_logging_component"]
    target_label  = "component"
  }

  rule {
    source_labels = ["__meta_docker_container_label_app_logging_service_name"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  host       = "http://docker-socket-proxy:2375"
  targets    = discovery.relabel.container_logs.output
  labels     = { source = "docker" }
  forward_to = [loki.process.container_logs.receiver]
}

loki.process "container_logs" {
  stage.decolorize {}

  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = sys.env("LOKI_URL")

    basic_auth {
      username      = sys.env("LOKI_USERNAME")
      password_file = "/run/secrets/loki_password"
    }
  }
}
