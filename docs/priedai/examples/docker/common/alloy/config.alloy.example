// Inactive example. Copy to docker/alloy/config.alloy; it is mounted by
// docker-compose.observability.yml.
//
// Alloy reads containers through the Docker socket proxy, never through the
// Docker socket itself, and ships their stdout/stderr to the central Loki.
// Settings come from SECRETS_DIR/alloy.env (LOKI_URL, LOKI_USERNAME,
// DEPLOY_ENV, NODE_NAME); the push credential is the loki_password secret.

logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "containers" {
  host = "http://docker-socket-proxy:2375"

  // Only containers that opt in with the app.logging.enabled label (the
  // x-log-labels anchors in the production Compose file). Both slots of a
  // blue-green deployment carry the same labels, so a new slot is collected
  // as soon as it starts. Alloy and the socket proxy carry no such label.
  filter {
    name   = "label"
    values = ["app.logging.enabled=true"]
  }
}

discovery.relabel "container_logs" {
  targets = discovery.docker.containers.targets

  rule {
    target_label = "app"
    replacement  = "<application>"
  }

  rule {
    target_label = "environment"
    replacement  = sys.env("DEPLOY_ENV")
  }

  rule {
    target_label = "node"
    replacement  = sys.env("NODE_NAME")
  }

  rule {
    source_labels = ["__meta_docker_container_label_app_logging_type"]
    target_label  = "type"
  }

  rule {
    source_labels = ["__meta_docker_container_label_app_logging_component"]
    target_label  = "component"
  }

  rule {
    source_labels = ["__meta_docker_container_label_app_logging_service_name"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
    replacement   = "$1"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    target_label  = "compose_project"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "compose_service"
  }
}

loki.source.docker "containers" {
  // The Docker API tails each selected container's stdout and stderr; Docker
  // preserves their origin as the Loki `stream` label.
  host       = "http://docker-socket-proxy:2375"
  targets    = discovery.relabel.container_logs.output
  labels     = { source = "docker" }
  forward_to = [loki.process.container_logs.receiver]
}

loki.process "container_logs" {
  stage.docker {}
  stage.decolorize {}

  forward_to = [loki.write.central.receiver]
}

loki.write "central" {
  endpoint {
    url = sys.env("LOKI_URL")

    basic_auth {
      username      = sys.env("LOKI_USERNAME")
      password_file = "/run/secrets/loki_password"
    }
  }
}
