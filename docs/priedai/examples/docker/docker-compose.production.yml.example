# Reference production stack. Keep this file outside .github/workflows/ and
# replace every required environment value before use.

name: ${COMPOSE_PROJECT_NAME:-application}

services:
  app:
    image: ${APP_IMAGE:?set APP_IMAGE to a tested immutable digest}
    restart: unless-stopped
    read_only: true
    env_file:
      - ${RUNTIME_ENV_FILE:?set RUNTIME_ENV_FILE}
    tmpfs:
      - /tmp:size=64m,noexec,nosuid
    volumes:
      - app_storage:/var/www/storage
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "php artisan about --no-ansi >/dev/null || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 12
    networks: [backend]

  worker:
    image: ${APP_IMAGE:?set APP_IMAGE to a tested immutable digest}
    restart: unless-stopped
    read_only: true
    env_file:
      - ${RUNTIME_ENV_FILE:?set RUNTIME_ENV_FILE}
    tmpfs:
      - /tmp:size=64m,noexec,nosuid
    volumes:
      - app_storage:/var/www/storage
    command: ["php", "artisan", "queue:work", "redis", "--sleep=3", "--tries=3", "--max-time=3600"]
    depends_on:
      app:
        condition: service_healthy
    networks: [backend]

  nginx:
    image: ${NGINX_IMAGE:?set NGINX_IMAGE to a tested immutable digest}
    restart: unless-stopped
    read_only: true
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      - app_storage:/var/www/storage:ro
      - ${NGINX_CONFIG_DIR:?set NGINX_CONFIG_DIR}/default.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      app:
        condition: service_healthy
    networks: [backend]

  alloy:
    image: ${ALLOY_IMAGE:?set ALLOY_IMAGE to a reviewed immutable digest}
    restart: unless-stopped
    profiles: [observability]
    command: ["run", "/etc/alloy/config.alloy", "--storage.path=/var/lib/alloy/data"]
    volumes:
      - ${ALLOY_CONFIG_DIR:?set ALLOY_CONFIG_DIR}/config.alloy:/etc/alloy/config.alloy:ro
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - alloy_data:/var/lib/alloy/data
    networks: [backend]

  mysql:
    image: ${MYSQL_IMAGE:?set MYSQL_IMAGE to a reviewed immutable digest}
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: ${DB_DATABASE:?set DB_DATABASE}
      MYSQL_USER: ${DB_USERNAME:?set DB_USERNAME}
      MYSQL_PASSWORD_FILE: /run/secrets/db_password
      MYSQL_ROOT_PASSWORD_FILE: /run/secrets/db_root_password
    secrets: [db_password, db_root_password]
    volumes:
      - mysql_data:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mysqladmin ping -h 127.0.0.1 -u root -p\"$$(cat /run/secrets/db_root_password)\" --silent"]
      interval: 10s
      timeout: 5s
      retries: 12
    networks: [backend]

  redis:
    image: ${REDIS_IMAGE:?set REDIS_IMAGE to a reviewed immutable digest}
    restart: unless-stopped
    command: ["redis-server", "/run/secrets/redis.conf"]
    secrets: [redis.conf]
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$$(sed -n 's/^requirepass //p' /run/secrets/redis.conf)\" ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 12
    networks: [backend]

volumes:
  app_storage:
  mysql_data:
  redis_data:
  alloy_data:

networks:
  backend:
    driver: bridge

secrets:
  db_password:
    file: ${RUNTIME_SECRETS_DIR:?set RUNTIME_SECRETS_DIR}/db_password
  db_root_password:
    file: ${RUNTIME_SECRETS_DIR:?set RUNTIME_SECRETS_DIR}/db_root_password
  redis.conf:
    file: ${RUNTIME_SECRETS_DIR:?set RUNTIME_SECRETS_DIR}/redis.conf
