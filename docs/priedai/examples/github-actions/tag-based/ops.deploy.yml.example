# Inactive example. Copy to .github/workflows/ops.deploy.yml.

name: Example - Ops Deploy (tag-based)

on:
  workflow_dispatch:
    inputs:
      image_tag:
        description: Immutable production release tag (vX.Y.Z).
        required: true
        type: string

permissions:
  contents: read
  packages: read
  attestations: read

concurrency:
  group: ops-deploy-production
  cancel-in-progress: false

jobs:
  resolve-release:
    name: Resolve and verify production release tag
    runs-on: ubuntu-latest
    timeout-minutes: 10
    outputs:
      source_sha: ${{ steps.image.outputs.source_sha }}
      app_image: ${{ steps.image.outputs.app_image }}
      nginx_image: ${{ steps.image.outputs.nginx_image }}
      release_workflow: ${{ steps.image.outputs.release_workflow }}
    env:
      RELEASE_TAG: ${{ inputs.image_tag }}
      APP_REPOSITORY: ghcr.io/<org>/<app>-php
      NGINX_REPOSITORY: ghcr.io/<org>/<app>-nginx
    steps:
      - name: Validate and checkout the release tag
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ inputs.image_tag }}
          fetch-depth: 0
          persist-credentials: false

      - name: Verify the release tag is an immutable main release
        shell: bash
        run: |
          set -euo pipefail
          [[ "$RELEASE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
            echo "image_tag must be a semantic release tag in the form vX.Y.Z." >&2
            exit 1
          }
          git show-ref --verify --quiet refs/remotes/origin/main || {
            echo "origin/main was not fetched by the checkout step." >&2
            exit 1
          }
          TAG_SHA="$(git rev-list -n 1 "$RELEASE_TAG")"
          git show-ref --verify --quiet "refs/tags/$RELEASE_TAG"
          git merge-base --is-ancestor "$TAG_SHA" origin/main || {
            echo "Release tag $RELEASE_TAG does not point to a commit reachable from origin/main." >&2
            exit 1
          }
          printf 'TAG_SHA=%s\n' "$TAG_SHA" >> "$GITHUB_ENV"

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4

      - name: Log in to the container registry
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Resolve release tag to immutable images
        id: image
        shell: bash
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          resolve_digest() {
            local repository="$1" output digest
            output="$(docker buildx imagetools inspect "${repository}:${RELEASE_TAG}" 2>&1)" || {
              echo "$output" >&2
              return 1
            }
            digest="$(awk '$1 == "Digest:" { print $2; exit }' <<<"$output")"
            [[ "$digest" =~ ^sha256:[a-f0-9]{64}$ ]] || {
              echo "Release tag ${repository}:${RELEASE_TAG} did not resolve to a digest." >&2
              return 1
            }
            printf '%s' "$digest"
          }
          app_digest="$(resolve_digest "$APP_REPOSITORY")"
          nginx_digest="$(resolve_digest "$NGINX_REPOSITORY")"
          app_image="${APP_REPOSITORY}@${app_digest}"
          nginx_image="${NGINX_REPOSITORY}@${nginx_digest}"
          docker pull "$app_image" >/dev/null
          docker pull "$nginx_image" >/dev/null
          app_revision="$(docker image inspect "$app_image" --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}')"
          nginx_revision="$(docker image inspect "$nginx_image" --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}')"
          [[ "$app_revision" =~ ^[0-9a-f]{40}$ ]]
          [[ "$nginx_revision" == "$app_revision" ]]
          [[ "$app_revision" == "$TAG_SHA" ]] || {
            echo "Release tag $RELEASE_TAG and image source revision do not match." >&2
            exit 1
          }
          for image in "$app_image" "$nginx_image"; do
            gh attestation verify "oci://${image}" \
              --repo "$GITHUB_REPOSITORY" \
              --signer-workflow "${GITHUB_REPOSITORY}/.github/workflows/ci.build.yml" \
              --source-ref refs/heads/main
          done
          {
            echo "source_sha=$app_revision"
            echo "app_image=$app_image"
            echo "nginx_image=$nginx_image"
            echo "release_workflow=${GITHUB_REPOSITORY}/.github/workflows/ci.release.yml"
          } >> "$GITHUB_OUTPUT"

  redeploy:
    name: Redeploy production release tag
    needs: resolve-release
    if: needs.resolve-release.result == 'success'
    uses: ./.github/workflows/cd.deploy.yml
    with:
      environment: production
      source_sha: ${{ needs.resolve-release.outputs.source_sha }}
      app_image: ${{ needs.resolve-release.outputs.app_image }}
      nginx_image: ${{ needs.resolve-release.outputs.nginx_image }}
      release_workflow: ${{ needs.resolve-release.outputs.release_workflow }}
      release_attestation_required: true
    secrets: inherit
