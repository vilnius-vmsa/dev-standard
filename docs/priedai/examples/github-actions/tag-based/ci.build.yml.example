name: Example - CI Build (tag candidate)

on:
  workflow_run:
    workflows: ["CI: Pipeline"]
    types: [completed]
    branches: [main]

permissions:
  contents: read
  packages: write
  id-token: write
  attestations: write

jobs:
  build-test-attest:
    # One group for every candidate build, so candidates are built in merge
    # order and staging ends on the newest commit. The group is on the job,
    # not on the workflow: a workflow-level group is taken as soon as a run is
    # queued, before the `if` below is evaluated, so a run that is only going
    # to be skipped (failed CI: Pipeline, a pull request) would push a real
    # pending candidate out of the queue. A skipped job never takes the group.
    # GitHub keeps one pending job per group: when several merges queue up,
    # an older pending candidate is cancelled. That commit then has no
    # staging-verified attestation and cannot be released; tag the newer
    # commit, or re-run this workflow run for the commit that must be released.
    concurrency:
      group: tag-candidate-main
      cancel-in-progress: false
    # workflow_run also fires for pull-request runs of CI: Pipeline, and the
    # `branches` filter matches the head branch name only. Build solely for a
    # push to main in this repository, never for a pull request (including
    # one from a fork whose branch is named main).
    if: >-
      github.event.workflow_run.conclusion == 'success' &&
      github.event.workflow_run.event == 'push' &&
      github.event.workflow_run.head_branch == 'main' &&
      github.event.workflow_run.head_repository.full_name == github.repository
    runs-on: ubuntu-latest
    timeout-minutes: 20
    outputs:
      source_sha: ${{ steps.meta.outputs.source_sha }}
      app_image: ${{ steps.image.outputs.app_image }}
      nginx_image: ${{ steps.image.outputs.nginx_image }}
    steps:
      - name: Checkout exact linted main revision
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ github.event.workflow_run.head_sha }}
          fetch-depth: 1

      - name: Resolve candidate metadata
        id: meta
        env:
          SOURCE_SHA: ${{ github.event.workflow_run.head_sha }}
        run: |
          set -euo pipefail
          [[ "$SOURCE_SHA" =~ ^[0-9a-f]{40}$ ]]
          printf 'source_sha=%s\n' "$SOURCE_SHA" >> "$GITHUB_OUTPUT"

      - name: Log in to the container registry
        env:
          GH_TOKEN: ${{ github.token }}
        run: echo "$GH_TOKEN" | docker login ghcr.io -u "${{ github.actor }}" --password-stdin

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4

      # Short-lived token for the private Composer packages the image build
      # installs. Without `owner` and `repositories` the token is valid only
      # for this repository and `composer install` fails on the first private
      # package, so list every private package repository here.
      # COMPOSER_APP_ID is a repository or organisation variable and
      # COMPOSER_APP_PRIVATE_KEY a repository or organisation secret: this job
      # declares no Environment, so an Environment secret would be empty.
      # Remove the step (and the build secret below) when the project has no
      # private packages.
      - name: Create Composer GitHub App token
        id: github-app-token
        uses: actions/create-github-app-token@fee1f7d63c2ff003460e3d139729b119787bc349 # v2
        with:
          app-id: ${{ vars.COMPOSER_APP_ID }}
          private-key: ${{ secrets.COMPOSER_APP_PRIVATE_KEY }}
          owner: vilnius-vmsa
          # Example names; replace with the project's private packages.
          repositories: |
            example-laravel-package
            example-shared-library

      - name: Build and push PHP-FPM candidate image
        id: php
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7
        with:
          context: .
          file: ./docker/php-fpm/Dockerfile.prod
          push: true
          build-args: |
            RELEASE_NUMBER=${{ steps.meta.outputs.source_sha }}
          secrets: |
            composer_auth={"github-oauth":{"github.com":"${{ steps.github-app-token.outputs.token }}"}}
          tags: ghcr.io/<org>/<app>-php:candidate-${{ steps.meta.outputs.source_sha }}-${{ github.run_id }}
          labels: |
            org.opencontainers.image.revision=${{ steps.meta.outputs.source_sha }}
            org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}
            org.opencontainers.image.version=candidate-${{ steps.meta.outputs.source_sha }}-${{ github.run_id }}
          provenance: mode=max
          sbom: true
          cache-from: type=registry,ref=ghcr.io/<org>/<app>-php:buildcache
          cache-to: type=registry,ref=ghcr.io/<org>/<app>-php:buildcache,mode=max

      - name: Build and push Nginx candidate image
        id: nginx
        uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7
        with:
          context: .
          file: ./docker/nginx/Dockerfile.prod
          push: true
          build-args: |
            PHP_IMAGE_REF=ghcr.io/<org>/<app>-php@${{ steps.php.outputs.digest }}
          tags: ghcr.io/<org>/<app>-nginx:candidate-${{ steps.meta.outputs.source_sha }}-${{ github.run_id }}
          labels: |
            org.opencontainers.image.revision=${{ steps.meta.outputs.source_sha }}
            org.opencontainers.image.source=${{ github.server_url }}/${{ github.repository }}
            org.opencontainers.image.version=candidate-${{ steps.meta.outputs.source_sha }}-${{ github.run_id }}
          provenance: mode=max
          sbom: true
          cache-from: type=registry,ref=ghcr.io/<org>/<app>-nginx:buildcache
          cache-to: type=registry,ref=ghcr.io/<org>/<app>-nginx:buildcache,mode=max

      - name: Resolve published image digests
        id: image
        shell: bash
        env:
          SOURCE_SHA: ${{ steps.meta.outputs.source_sha }}
          APP_REPOSITORY: ghcr.io/<org>/<app>-php
          NGINX_REPOSITORY: ghcr.io/<org>/<app>-nginx
          APP_DIGEST: ${{ steps.php.outputs.digest }}
          NGINX_DIGEST: ${{ steps.nginx.outputs.digest }}
        run: |
          set -euo pipefail
          CANDIDATE_TAG="candidate-${SOURCE_SHA}-${GITHUB_RUN_ID}"
          [[ "$APP_DIGEST" == sha256:* && "$NGINX_DIGEST" == sha256:* ]]
          echo "app_repository=$APP_REPOSITORY" >> "$GITHUB_OUTPUT"
          echo "app_digest=$APP_DIGEST" >> "$GITHUB_OUTPUT"
          echo "nginx_repository=$NGINX_REPOSITORY" >> "$GITHUB_OUTPUT"
          echo "nginx_digest=$NGINX_DIGEST" >> "$GITHUB_OUTPUT"
          echo "app_image=$APP_REPOSITORY@$APP_DIGEST" >> "$GITHUB_OUTPUT"
          echo "nginx_image=$NGINX_REPOSITORY@$NGINX_DIGEST" >> "$GITHUB_OUTPUT"

      - name: Scan candidate application image
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          image-ref: ${{ steps.image.outputs.app_image }}
          ignore-unfixed: true
          severity: CRITICAL,HIGH
          exit-code: '1'
          format: table

      - name: Scan candidate Nginx image
        uses: aquasecurity/trivy-action@ed142fd0673e97e23eac54620cfb913e5ce36c25 # v0.36.0
        with:
          image-ref: ${{ steps.image.outputs.nginx_image }}
          ignore-unfixed: true
          severity: CRITICAL,HIGH
          exit-code: '1'
          format: table

      - name: Verify SBOM and BuildKit provenance
        shell: bash
        env:
          APP_IMAGE: ${{ steps.image.outputs.app_image }}
          NGINX_IMAGE: ${{ steps.image.outputs.nginx_image }}
        run: |
          set -euo pipefail
          for image in "$APP_IMAGE" "$NGINX_IMAGE"; do
            sbom="$(docker buildx imagetools inspect "$image" --format '{{ json .SBOM }}')"
            provenance="$(docker buildx imagetools inspect "$image" --format '{{ json .Provenance }}')"
            jq -e '[.. | objects | select(.SPDXID? == "SPDXRef-DOCUMENT" and ((.packages? // []) | length > 0))] | length > 0' <<<"$sbom" >/dev/null
            jq -e '[.. | objects | select(((.buildType? // "") | length > 0) or ((.buildDefinition?.buildType? // "") | length > 0))] | length > 0' <<<"$provenance" >/dev/null
          done

      - name: Attest candidate application image
        uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4
        with:
          subject-name: ${{ steps.image.outputs.app_repository }}
          subject-digest: ${{ steps.image.outputs.app_digest }}
          push-to-registry: true

      - name: Attest candidate Nginx image
        uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4
        with:
          subject-name: ${{ steps.image.outputs.nginx_repository }}
          subject-digest: ${{ steps.image.outputs.nginx_digest }}
          push-to-registry: true

      - name: Verify build attestations before smoke test
        shell: bash
        env:
          GH_TOKEN: ${{ github.token }}
          APP_IMAGE: ${{ steps.image.outputs.app_image }}
          NGINX_IMAGE: ${{ steps.image.outputs.nginx_image }}
        run: |
          set -euo pipefail
          for image in "$APP_IMAGE" "$NGINX_IMAGE"; do
            gh attestation verify "oci://${image}" \
              --repo "$GITHUB_REPOSITORY" \
              --signer-workflow "${GITHUB_REPOSITORY}/.github/workflows/ci.build.yml"
          done

      - name: Smoke-test candidate PHP, Nginx, database, Redis and worker images
        shell: bash
        env:
          APP_IMAGE: ${{ steps.image.outputs.app_image }}
          NGINX_IMAGE: ${{ steps.image.outputs.nginx_image }}
          # The script reads the topology (single-slot or blue-green) from
          # docker-compose.production.yml; set SMOKE_TOPOLOGY only to override.
          # The readiness route must report this revision as "release".
          SOURCE_SHA: ${{ steps.meta.outputs.source_sha }}
          SMOKE_JOB_CLASS: 'App\Jobs\SmokeTestJob'
          SMOKE_JOB_ID: dev-standard-ci-job-${{ github.run_id }}-${{ github.run_attempt }}
        # Copy docker/common/scripts/smoke-published-images.sh.example to the
        # consuming repository as docker/scripts/smoke-published-images.sh.
        # It runs the images through docker-compose.production.yml,
        # docker-compose.ci-smoke.override.yml and docker/scripts/prepare-runtime-secrets.sh
        # from this checkout, with disposable values only.
        run: bash docker/scripts/smoke-published-images.sh

  deploy-staging:
    name: Deploy candidate to staging
    needs: build-test-attest
    if: ${{ needs.build-test-attest.result == 'success' }}
    permissions:
      contents: read
      packages: read
      attestations: read
    uses: ./.github/workflows/cd.deploy.yml
    with:
      environment: staging
      source_sha: ${{ needs.build-test-attest.outputs.source_sha }}
      app_image: ${{ needs.build-test-attest.outputs.app_image }}
      nginx_image: ${{ needs.build-test-attest.outputs.nginx_image }}
      release_workflow: ${{ github.repository }}/.github/workflows/ci.build.yml
      release_attestation_required: false
    secrets: inherit

  # Runs only after the staging deployment and its readiness gate succeeded.
  # It records that fact in two ways:
  # - a signed "staging-verified" attestation on each image digest, which is
  #   the evidence ci.release verifies before promoting to production;
  # - the immutable sha-<source SHA> tag, which is only how ci.release finds
  #   the digest. A tag alone proves nothing: anyone who can write packages
  #   can create one.
  publish-staging-source-tags:
    name: Attest and label staging-verified images
    needs: [build-test-attest, deploy-staging]
    if: needs.deploy-staging.result == 'success'
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
    env:
      SOURCE_SHA: ${{ needs.build-test-attest.outputs.source_sha }}
      APP_IMAGE: ${{ needs.build-test-attest.outputs.app_image }}
      NGINX_IMAGE: ${{ needs.build-test-attest.outputs.nginx_image }}
    steps:
      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4

      - name: Log in to the container registry
        env:
          GH_TOKEN: ${{ github.token }}
        run: echo "$GH_TOKEN" | docker login ghcr.io -u "${{ github.actor }}" --password-stdin

      - name: Resolve attestation subjects
        id: subject
        shell: bash
        run: |
          set -euo pipefail
          {
            echo "app_repository=${APP_IMAGE%@*}"
            echo "app_digest=${APP_IMAGE##*@}"
            echo "nginx_repository=${NGINX_IMAGE%@*}"
            echo "nginx_digest=${NGINX_IMAGE##*@}"
          } >> "$GITHUB_OUTPUT"

      # Replace <org-domain> with the organisation's own namespace; the same
      # predicate type is verified in ci.release.yml.
      - name: Attest staging-verified application image
        uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4
        with:
          subject-name: ${{ steps.subject.outputs.app_repository }}
          subject-digest: ${{ steps.subject.outputs.app_digest }}
          predicate-type: https://<org-domain>/attestation/staging-verified/v1
          predicate: '{"purl":"pkg:github/${{ github.repository }}@${{ needs.build-test-attest.outputs.source_sha }}","environment":"staging","run_id":"${{ github.run_id }}","run_attempt":"${{ github.run_attempt }}"}'
          push-to-registry: true
          create-storage-record: false

      - name: Attest staging-verified Nginx image
        uses: actions/attest@1e69f48acb82d1966a394da916b4c1698aa569d6 # v4
        with:
          subject-name: ${{ steps.subject.outputs.nginx_repository }}
          subject-digest: ${{ steps.subject.outputs.nginx_digest }}
          predicate-type: https://<org-domain>/attestation/staging-verified/v1
          predicate: '{"purl":"pkg:github/${{ github.repository }}@${{ needs.build-test-attest.outputs.source_sha }}","environment":"staging","run_id":"${{ github.run_id }}","run_attempt":"${{ github.run_attempt }}"}'
          push-to-registry: true
          create-storage-record: false

      - name: Publish immutable source tags
        shell: bash
        run: |
          set -euo pipefail
          # An immutable tag is created once. If it already exists it must
          # point at the same digest; it is never moved. A rebuild of the same
          # commit produces a different digest and therefore stops here: the
          # image already published for that commit is redeployed through
          # Ops: Deploy instead.
          ensure_immutable_tag() {
            local repository="$1" digest="$2" tag="$3" output actual
            [[ "$digest" =~ ^sha256:[a-f0-9]{64}$ ]] || {
              echo "Invalid digest for ${repository}:${tag}: ${digest}" >&2
              return 1
            }
            if output="$(docker buildx imagetools inspect "${repository}:${tag}" 2>&1)"; then
              actual="$(awk '/^Digest:/ { print $2; exit }' <<<"$output")"
              [[ "$actual" = "$digest" ]] || {
                echo "Immutable ${repository}:${tag} already points to ${actual}, not ${digest}." >&2
                return 1
              }
              return 0
            fi
            # Only a missing tag may be created; any other registry error stops.
            grep -Eqi 'not found|manifest unknown|no such manifest' <<<"$output" || {
              echo "$output" >&2
              return 1
            }
            docker buildx imagetools create --tag "${repository}:${tag}" "${repository}@${digest}"
            for attempt in $(seq 1 15); do
              if output="$(docker buildx imagetools inspect "${repository}:${tag}" 2>&1)"; then
                actual="$(awk '/^Digest:/ { print $2; exit }' <<<"$output")"
                [[ "$actual" = "$digest" ]] && return 0
              fi
              sleep 2
            done
            echo "${repository}:${tag} does not preserve ${digest}." >&2
            echo "$output" >&2
            return 1
          }
          ensure_immutable_tag "${APP_IMAGE%@*}" "${APP_IMAGE##*@}" "sha-$SOURCE_SHA"
          ensure_immutable_tag "${NGINX_IMAGE%@*}" "${NGINX_IMAGE##*@}" "sha-$SOURCE_SHA"
