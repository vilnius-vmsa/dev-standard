name: Example - Ops housekeeping

on:
  schedule:
    - cron: "0 0 * * *"
  workflow_dispatch:
    inputs:
      days:
        description: Retention period for workflow artifacts and logs.
        required: false
        default: "30"
        type: string

concurrency:
  group: ops-housekeeping
  cancel-in-progress: false

permissions:
  actions: write

jobs:
  housekeeping:
    name: Retain only required CI artifacts
    uses: vilnius-vmsa/shared-workflows/.github/workflows/housekeeping.yml@<reviewed-commit-sha>
    with:
      days: ${{ inputs.days || '30' }}
