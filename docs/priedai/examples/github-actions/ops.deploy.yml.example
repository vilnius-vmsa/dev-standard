name: Example - Ops Deploy

# Inactive example. Copy to .github/workflows/ops.deploy.yml only after the
# reusable cd.deploy workflow and the consuming repository's contracts have
# been adapted. This workflow never builds or promotes images.

on:
  workflow_dispatch:
    inputs:
      operation:
        description: Immutable redeploy or allowlisted runtime service restart.
        required: true
        default: redeploy
        type: choice
        options: [redeploy, restart]
      environment:
        description: Target GitHub Environment.
        required: true
        type: choice
        options: [staging, production]
      image_tag:
        description: Optional immutable sha-<40> tag; empty uses the promoted environment tag.
        required: false
        default: ""
        type: string
      service:
        description: Required for restart; service to recreate from the local image.
        required: false
        type: choice
        options: [balancer, nginx-blue, nginx-green]

permissions:
  contents: read
  packages: read
  attestations: read

concurrency:
  group: ops-deploy-${{ inputs.environment }}-${{ inputs.operation }}-${{ inputs.service || 'images' }}
  cancel-in-progress: false

jobs:
  resolve-image:
    name: Resolve promoted deployment image
    if: ${{ inputs.operation == 'redeploy' }}
    runs-on: ubuntu-latest
    timeout-minutes: 10
    env:
      ENVIRONMENT: ${{ inputs.environment }}
      REQUESTED_TAG: ${{ inputs.image_tag }}
      APP_REPOSITORY: ghcr.io/<owner>/<application>-image-php
      NGINX_REPOSITORY: ghcr.io/<owner>/<application>-image-nginx
    outputs:
      source_sha: ${{ steps.image.outputs.source_sha }}
      app_image: ${{ steps.image.outputs.app_image }}
      nginx_image: ${{ steps.image.outputs.nginx_image }}
      release_workflow: ${{ steps.image.outputs.release_workflow }}
    steps:
      - name: Log in to the container registry
        uses: docker/login-action@<reviewed-commit-sha>
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Resolve promoted tag to immutable images
        id: image
        shell: bash
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          case "$ENVIRONMENT" in
            staging|production) default_tag="$ENVIRONMENT" ;;
            *) echo "Unsupported environment: $ENVIRONMENT" >&2; exit 1 ;;
          esac
          if [ -n "$REQUESTED_TAG" ]; then
            [[ "$REQUESTED_TAG" =~ ^sha-[0-9a-f]{40}$ ]] || {
              echo "image_tag must be sha-<40 hex> when provided." >&2
              exit 1
            }
            tag="$REQUESTED_TAG"
          else
            tag="$default_tag"
          fi
          resolve_digest() {
            local repository="$1" output digest
            output="$(docker buildx imagetools inspect "${repository}:${tag}" 2>&1)" || {
              echo "$output" >&2
              return 1
            }
            digest="$(awk '$1 == "Digest:" { print $2; exit }' <<<"$output")"
            [[ "$digest" =~ ^sha256:[0-9a-f]{64}$ ]]
            printf '%s' "$digest"
          }
          app_digest="$(resolve_digest "$APP_REPOSITORY")"
          nginx_digest="$(resolve_digest "$NGINX_REPOSITORY")"
          app_image="${APP_REPOSITORY}@${app_digest}"
          nginx_image="${NGINX_REPOSITORY}@${nginx_digest}"
          docker pull "$app_image" >/dev/null
          docker pull "$nginx_image" >/dev/null
          app_revision="$(docker image inspect "$app_image" --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}')"
          nginx_revision="$(docker image inspect "$nginx_image" --format '{{ index .Config.Labels "org.opencontainers.image.revision" }}')"
          [[ "$app_revision" =~ ^[0-9a-f]{40}$ ]]
          [[ "$nginx_revision" == "$app_revision" ]]
          if [[ "$tag" =~ ^sha-([0-9a-f]{40})$ ]]; then
            [[ "${BASH_REMATCH[1]}" == "$app_revision" ]]
          fi
          for image in "$app_image" "$nginx_image"; do
            gh attestation verify "oci://${image}" \
              --repo "$GITHUB_REPOSITORY" \
              --signer-workflow "${GITHUB_REPOSITORY}/.github/workflows/ci.build.yml"
          done
          {
            echo "source_sha=$app_revision"
            echo "app_image=$app_image"
            echo "nginx_image=$nginx_image"
            echo "release_workflow=${GITHUB_REPOSITORY}/.github/workflows/ci.build.yml"
          } >> "$GITHUB_OUTPUT"

  redeploy:
    name: Redeploy resolved ${{ inputs.environment }} images
    if: ${{ inputs.operation == 'redeploy' }}
    needs: resolve-image
    uses: ./.github/workflows/cd.deploy.yml
    with:
      environment: ${{ inputs.environment }}
      source_sha: ${{ needs.resolve-image.outputs.source_sha }}
      app_image: ${{ needs.resolve-image.outputs.app_image }}
      nginx_image: ${{ needs.resolve-image.outputs.nginx_image }}
      release_workflow: ${{ needs.resolve-image.outputs.release_workflow }}
    secrets: inherit

  restart:
    name: Recreate ${{ inputs.service }} in ${{ inputs.environment }}
    if: ${{ inputs.operation == 'restart' }}
    runs-on: [self-hosted, Linux, "${{ inputs.environment }}"]
    environment: ${{ inputs.environment }}
    timeout-minutes: 10
    permissions:
      contents: read
    env:
      TARGET_SERVICE: ${{ inputs.service }}
      DEPLOY_ENVIRONMENT: ${{ inputs.environment }}
      COMPOSE_PROJECT_NAME: REPLACE_APPLICATION-${{ inputs.environment }}
      SECRETS_DIR: ${{ vars.SECRETS_DIR || format('/home/ubuntu/secrets/REPLACE_APPLICATION-{0}', inputs.environment) }}
    steps:
      - name: Checkout deployment configuration
        uses: actions/checkout@<reviewed-commit-sha>
        with:
          ref: main
          persist-credentials: false
          sparse-checkout: |
            docker-compose.production.blue-green.yml
            scripts/prepare-secrets.sh

      - name: Check available disk space
        shell: bash
        run: |
          set -euo pipefail
          available_kb="$(df -Pk / | awk 'NR == 2 { print $4 }')"
          test "$available_kb" -ge 1048576

      - name: Prepare host-managed runtime secrets when configured
        shell: bash
        env:
          PRODUCTION_ENV: ${{ secrets.PRODUCTION_ENV }}
          TLS_CERTIFICATE_B64: ${{ secrets.TLS_CERTIFICATE_B64 }}
          TLS_PRIVATE_KEY_B64: ${{ secrets.TLS_PRIVATE_KEY_B64 }}
        run: |
          set -euo pipefail
          if [[ -z "$PRODUCTION_ENV" && -z "$TLS_CERTIFICATE_B64" && -z "$TLS_PRIVATE_KEY_B64" ]]; then
            echo "Secret provisioning inputs are not configured; using existing files in SECRETS_DIR."
          elif [[ -n "$PRODUCTION_ENV" && -n "$TLS_CERTIFICATE_B64" && -n "$TLS_PRIVATE_KEY_B64" ]]; then
            ./scripts/prepare-secrets.sh \
              --environment "$DEPLOY_ENVIRONMENT" \
              --secrets-dir "$SECRETS_DIR"
          else
            echo "PRODUCTION_ENV, TLS_CERTIFICATE_B64, and TLS_PRIVATE_KEY_B64 must be configured together." >&2
            exit 1
          fi

      - name: Validate restart target and runtime files
        shell: bash
        run: |
          set -euo pipefail
          case "$DEPLOY_ENVIRONMENT:$TARGET_SERVICE" in
            staging:balancer|staging:nginx-blue|staging:nginx-green|production:balancer|production:nginx-blue|production:nginx-green) ;;
            *) echo "Unsupported restart target: $DEPLOY_ENVIRONMENT/$TARGET_SERVICE" >&2; exit 1 ;;
          esac
          test -r "$SECRETS_DIR/compose.env"
          test -r "$SECRETS_DIR/application.env"
          test -s "$SECRETS_DIR/tls_certificate"
          test -s "$SECRETS_DIR/tls_private_key"
          test -s "$SECRETS_DIR/upstream.conf"
          docker compose --env-file "$SECRETS_DIR/compose.env" \
            -f docker-compose.production.blue-green.yml \
            --profile blue --profile green --profile balancer config -q

      - name: Recreate selected service without pulling
        shell: bash
        run: |
          set -euo pipefail
          case "$TARGET_SERVICE" in
            balancer) profile=balancer ;;
            nginx-blue) profile=blue ;;
            nginx-green) profile=green ;;
            *) echo "Unsupported restart target: $TARGET_SERVICE" >&2; exit 1 ;;
          esac
          docker compose \
            --env-file "$SECRETS_DIR/compose.env" \
            -f docker-compose.production.blue-green.yml \
            --profile "$profile" \
            up -d --pull never --force-recreate --no-deps \
            --wait --wait-timeout 120 "$TARGET_SERVICE"

      - name: Verify recreated service
        shell: bash
        run: |
          set -euo pipefail
          case "$TARGET_SERVICE" in
            balancer) profile=balancer ;;
            nginx-blue) profile=blue ;;
            nginx-green) profile=green ;;
            *) echo "Unsupported restart target: $TARGET_SERVICE" >&2; exit 1 ;;
          esac
          compose=(docker compose --env-file "$SECRETS_DIR/compose.env" -f docker-compose.production.blue-green.yml --profile "$profile")
          "${compose[@]}" ps "$TARGET_SERVICE"
          if [ "$TARGET_SERVICE" = balancer ]; then
            "${compose[@]}" exec -T balancer nginx -t
            curl --fail --silent --show-error --insecure https://127.0.0.1/health
          else
            "${compose[@]}" exec -T "$TARGET_SERVICE" wget -q -O /dev/null http://127.0.0.1:8080/health
          fi
