name: Example - Ops start database (blue-green)

# Blue-green variant; copy it to .github/workflows/ops.start-database.yml
# INSTEAD of ../single-slot/ops.start-database.yml.example. MySQL is not part
# of a slot, so the steps are the same; what differs is what the secrets
# helper and the Compose file need for this topology: the per-slot image
# references, the balancer image and configuration directory, and the slot
# upstream files in the checkout. With the single-slot variant on a blue-green
# host the helper would rewrite compose.env without the slot values and the
# checkout would remove the upstream files the running slots mount.
#
# Operator-only: prepares the runtime secrets and starts MySQL. It is
# self-sufficient, so it works on a host where nothing has been deployed yet
# and after an incident. It never deploys, rebuilds or migrates application
# services.
#
# A normal first deployment does not need this workflow: CD: Deploy starts
# MySQL and Redis itself before the migration. Use this one to bring the
# database up ahead of the first deployment (for example to restore a dump)
# or to recover it without touching the application.
on:
  workflow_dispatch:
    inputs:
      environment:
        description: GitHub Environment and self-hosted runner label.
        required: true
        type: choice
        options: [staging, production]
      image_tag:
        description: Existing immutable image tag (sha-<40 hex> or vX.Y.Z). On a running environment use the currently deployed one.
        required: true
        type: string

permissions:
  contents: read
  packages: read

concurrency:
  # The same group as CD: Deploy: this workflow rewrites the runtime secrets
  # directory and must not run next to a deployment.
  group: cd-deploy-${{ inputs.environment }}
  cancel-in-progress: false

jobs:
  start-database:
    name: Start MySQL on ${{ inputs.environment }}
    # Runs only on the self-hosted runner of the target environment.
    runs-on: "${{ inputs.environment }}"
    environment: ${{ inputs.environment }}
    timeout-minutes: 15
    permissions:
      contents: read
      packages: read
    env:
      # Keep these aligned with CD: Deploy.
      COMPOSE_FILE: docker-compose.production.yml
      SECRETS_DIR: /srv/<application>/secrets
      IMAGE_TAG: ${{ inputs.image_tag }}
      APP_REPOSITORY: ghcr.io/<org>/<app>-php
      NGINX_REPOSITORY: ghcr.io/<org>/<app>-nginx
      # Keep these two identical to CD: Deploy.
      BALANCER_CONFIG_DIR: /srv/<application>/balancer
      BALANCER_IMAGE_REF: ghcr.io/<org>/<app>-balancer@sha256:<balancer-digest>
    steps:
      - name: Resolve the source revision of the image tag
        id: source
        shell: bash
        run: |
          set -euo pipefail
          # Check out the revision the images were built from, not the branch
          # the workflow was dispatched on: running containers bind-mount the
          # configuration files of this workspace.
          if [[ "$IMAGE_TAG" =~ ^sha-([0-9a-f]{40})$ ]]; then
            echo "ref=${BASH_REMATCH[1]}" >> "$GITHUB_OUTPUT"
          elif [[ "$IMAGE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
            echo "ref=refs/tags/${IMAGE_TAG}" >> "$GITHUB_OUTPUT"
          else
            echo "Use an immutable sha-<40 hex> or vX.Y.Z image tag; floating tags are not allowed." >&2
            exit 1
          fi

      - name: Checkout deployment configuration
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
        with:
          ref: ${{ steps.source.outputs.ref }}
          persist-credentials: false
          # The same file set as CD: Deploy. Running containers bind-mount
          # these files from this workspace, so a smaller checkout would
          # remove files they need after their next restart.
          sparse-checkout-cone-mode: false
          sparse-checkout: |
            docker-compose.production.yml
            docker-compose.observability.yml
            docker/alloy/config.alloy
            docker/nginx/conf.d/upstream.blue.conf
            docker/nginx/conf.d/upstream.green.conf
            docker/scripts/prepare-runtime-secrets.sh

      - name: Log in to the container registry
        uses: docker/login-action@dbcb813823bdd20940b903addbd779551569679f # v4
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Resolve immutable image references
        shell: bash
        run: |
          set -euo pipefail
          # The Compose file and the secrets helper require pinned image
          # references even though only MySQL is started here.
          [[ "$IMAGE_TAG" =~ ^(sha-[0-9a-f]{40}|v[0-9]+\.[0-9]+\.[0-9]+)$ ]] || {
            echo "Use an immutable sha-<40 hex> or vX.Y.Z image tag; floating tags are not allowed." >&2
            exit 1
          }
          resolve_digest() {
            local repository="$1" digest
            digest="$(docker buildx imagetools inspect "${repository}:${IMAGE_TAG}" | awk '/^Digest:/ { print $2; exit }')"
            [[ "$digest" =~ ^sha256:[a-f0-9]{64}$ ]] || {
              echo "${repository}:${IMAGE_TAG} did not resolve to a digest." >&2
              return 1
            }
            printf '%s@%s' "$repository" "$digest"
          }
          # Assign first: a failure inside $(...) of an echo would be ignored.
          php_image_ref="$(resolve_digest "$APP_REPOSITORY")"
          nginx_image_ref="$(resolve_digest "$NGINX_REPOSITORY")"
          # Both slots get the same references, as in CD: Deploy. On a running
          # environment pass the tag that is deployed now: compose.env is
          # rewritten with these values, and a later restart of a slot through
          # Compose would otherwise use another image.
          {
            echo "PHP_IMAGE_BLUE=$php_image_ref"
            echo "PHP_IMAGE_GREEN=$php_image_ref"
            echo "NGINX_IMAGE_BLUE=$nginx_image_ref"
            echo "NGINX_IMAGE_GREEN=$nginx_image_ref"
          } >> "$GITHUB_ENV"

      - name: Prepare runtime secrets and Compose environment
        shell: bash
        env:
          RUNTIME_ENV: ${{ secrets.RUNTIME_ENV }}
          DEPLOY_ENVIRONMENT: ${{ inputs.environment }}
          TLS_CERTIFICATE_B64: ${{ secrets.TLS_CERTIFICATE_B64 }}
          TLS_PRIVATE_KEY_B64: ${{ secrets.TLS_PRIVATE_KEY_B64 }}
          # The helper rebuilds the whole directory: pass the log-export
          # inputs too, or a running environment would lose them.
          ALLOY_ENV: ${{ secrets.ALLOY_ENV }}
          LOKI_PASSWORD: ${{ secrets.LOKI_PASSWORD }}
        run: bash docker/scripts/prepare-runtime-secrets.sh

      - name: Validate the prepared runtime configuration
        shell: bash
        run: |
          set -euo pipefail
          for file in compose.env application.env app_key mysql_password mysql_root_password redis_password tls_certificate tls_private_key; do
            test -s "$SECRETS_DIR/$file" || {
              echo "$SECRETS_DIR/$file was not prepared." >&2
              exit 1
            }
          done
          docker compose --env-file "$SECRETS_DIR/compose.env" -f "$COMPOSE_FILE" config -q

      - name: Start database and wait for health
        shell: bash
        run: |
          set -euo pipefail
          docker compose --env-file "$SECRETS_DIR/compose.env" \
            -f "$COMPOSE_FILE" up -d --wait --no-recreate mysql
          docker compose --env-file "$SECRETS_DIR/compose.env" \
            -f "$COMPOSE_FILE" ps mysql
