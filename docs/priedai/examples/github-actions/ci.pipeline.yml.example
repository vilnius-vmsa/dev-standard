name: Example - CI Pipeline

on:
  pull_request:
    branches: [stage, main]
    types: [opened, synchronize, reopened, ready_for_review]
  push:
    branches: [stage, main]

permissions:
  contents: read

jobs:
  lint:
    name: Lint, test and validate
    runs-on: ubuntu-latest
    timeout-minutes: 20
    steps:
      - name: Checkout exact revision
        uses: actions/checkout@v7

      - name: Validate Composer dependencies
        if: ${{ hashFiles('composer.json') != '' }}
        run: composer validate --strict --no-interaction

      - name: Audit Composer dependencies
        if: ${{ hashFiles('composer.lock') != '' }}
        run: composer audit --locked --no-interaction

      - name: Run application tests
        run: composer test --no-interaction

      - name: Install frontend dependencies
        if: ${{ hashFiles('package-lock.json') != '' }}
        run: npm ci --ignore-scripts

      - name: Audit frontend dependencies
        if: ${{ hashFiles('package-lock.json') != '' }}
        run: npm audit --audit-level=high

      - name: Build frontend assets
        if: ${{ hashFiles('package-lock.json') != '' }}
        run: npm run build

      - name: Validate production Compose
        if: ${{ hashFiles('docker-compose.production.yml') != '' }}
        run: docker compose -f docker-compose.production.yml config --quiet

      - name: Scan repository for secrets
        uses: gitleaks/gitleaks-action@v2

  detect-build-changes:
    name: Detect image-build changes
    needs: lint
    if: ${{ github.event_name == 'push' && needs.lint.result == 'success' }}
    runs-on: ubuntu-latest
    outputs:
      code_changed: ${{ steps.changes.outputs.code_changed }}
    steps:
      - name: Checkout pushed commit with history
        uses: actions/checkout@v7
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0

      - name: Check build-relevant paths
        id: changes
        shell: bash
        env:
          PUSH_BEFORE: ${{ github.event.before }}
          PUSH_AFTER: ${{ github.sha }}
        run: |
          set -euo pipefail
          [[ "$PUSH_AFTER" =~ ^[0-9a-f]{40}$ ]]
          zero_sha=0000000000000000000000000000000000000000
          if [ "$PUSH_BEFORE" = "$zero_sha" ]; then
            changed_files="$(git ls-tree -r --name-only "$PUSH_AFTER")"
          else
            [[ "$PUSH_BEFORE" =~ ^[0-9a-f]{40}$ ]]
            git cat-file -e "${PUSH_BEFORE}^{commit}"
            changed_files="$(git diff --name-only "$PUSH_BEFORE" "$PUSH_AFTER")"
          fi
          code_changed=false
          matched_files=""
          while IFS= read -r path; do
            [ -n "$path" ] || continue
            case "$path" in
              app/*|bootstrap/*|config/*|database/*|lang/*|public/*|resources/*|routes/*|src/*|docker/*|.github/workflows/ci.pipeline.yml|.github/workflows/ci.build.yml|.github/workflows/cd.deploy.yml|artisan|composer.json|composer.lock|package.json|package-lock.json|pnpm-lock.yaml|yarn.lock|vite.config.*|webpack.mix.js|postcss.config.*|tailwind.config.*|Dockerfile*|docker-compose*.yml|docker-compose*.yaml|compose*.yml|compose*.yaml|.dockerignore)
                code_changed=true
                matched_files="${matched_files}${path}"$'\n'
                ;;
            esac
          done <<< "$changed_files"
          echo "code_changed=$code_changed" >> "$GITHUB_OUTPUT"
          echo "Build-relevant changes: $code_changed"
          if [ -n "$matched_files" ]; then
            {
              echo "### Files triggering the image build"
              while IFS= read -r path; do
                [ -n "$path" ] || continue
                printf '%s\n' "- \`$path\`"
              done <<< "$matched_files"
            } >> "$GITHUB_STEP_SUMMARY"
          fi

  build:
    name: Build, verify, promote and deploy images
    needs: [lint, detect-build-changes]
    if: >-
      github.event_name == 'push' &&
      needs.lint.result == 'success' &&
      needs.detect-build-changes.result == 'success' &&
      needs.detect-build-changes.outputs.code_changed == 'true'
    permissions:
      contents: read
      packages: write
      id-token: write
      attestations: write
    uses: ./.github/workflows/ci.build.yml
    with:
      source_branch: ${{ github.ref_name }}
      source_sha: ${{ github.sha }}
    secrets: inherit

  sync-main-to-stage:
    name: Synchronize deployed main to stage
    needs: build
    if: >-
      github.event_name == 'push' &&
      github.ref_name == 'main' &&
      needs.build.result == 'success'
    permissions:
      contents: write
      pull-requests: write
      actions: read
    # Replace this with the reviewed shared-workflows revision used by the
    # consuming project. It must run only after the reusable build/deploy job.
    uses: vilnius-vmsa/shared-workflows/.github/workflows/sync.main-to-stage.yml@<reviewed-commit-sha>
    with:
      syncer_app_id: ${{ vars.SYNCER_APP_ID }}
      source_sha: ${{ github.sha }}
      source_branch: main
      deployment_run_id: ${{ github.run_id }}
    secrets:
      SYNCER_PRIVATE_KEY: ${{ secrets.SYNCER_PRIVATE_KEY }}
